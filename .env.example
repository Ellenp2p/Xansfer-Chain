# ── Backend ──────────────────────────────────────────────────────────────────
# SQLite database URL (default: sqlite:xansfer.db?mode=rwc)
DATABASE_URL=sqlite:xansfer.db?mode=rwc
# HTTP port (default: 3001)
PORT=3001
# Comma-separated origins allowed to call the API cross-origin.
# Required for production when the frontend is hosted on a different origin.
# Example: ALLOWED_ORIGINS=https://xansfer.example.com,https://www.xansfer.example.com
ALLOWED_ORIGINS=
# Path to chain config JSON (default: config/chains.json)
# CHAIN_CONFIG=config/chains.json
# Relay is a simulated executor — keep false in production.
RELAY_ENABLED=false
# Optional relay hot-wallet keys (only used when RELAY_ENABLED=true):
# RELAY_KEY_0=0x...
# RELAY_KEY_27=...
# RELAY_KEY_STELLAR=...

# ── Frontend (build-time) ────────────────────────────────────────────────────
# Optional custom Solana RPC endpoint
# VITE_SOLANA_RPC=
