{
  "name": "xansfer-chain",
  "private": true,
  "workspaces": [
    "frontend",
    "packages/wallet-connect"
  ],
  "scripts": {
    "dev": "bun run --cwd frontend dev",
    "dev:backend": "cargo run --manifest-path backend/Cargo.toml",
    "build:package": "bun run --cwd packages/wallet-connect build",
    "build": "bun run --cwd packages/wallet-connect build && bun run --cwd frontend build",
    "preview": "bun run --cwd frontend preview"
  },
  "overrides": {
    "@aptos-labs/ts-sdk": "7.2.0",
    "@aptos-labs/wallet-standard": "2.0.0"
  }
}
